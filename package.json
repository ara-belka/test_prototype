{
  "name": "v2",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "nuxt build",
    "build:local": "NUXT_MEDIA_PROXY_ENABLED=true NUXT_PUBLIC_MEDIA_PROXY_ENABLED=true nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "preview:local": "NUXT_MEDIA_PROXY_ENABLED=true NUXT_PUBLIC_MEDIA_PROXY_ENABLED=true nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:staged": "lint-staged",
    "typecheck": "nuxt prepare && vue-tsc -b --noEmit",
    "api:generate": "openapi-ts",
    "api:generate:watch": "openapi-ts --watch",
    "api:check": "pnpm run api:generate && pnpm run typecheck",
    "lh:ci": "npm_config_loglevel=error pnpm dlx @lhci/cli@0.15.1 autorun --config=./lighthouserc.json",
    "ci:lighthouse": "pnpm run build && pnpm run lh:ci",
    "tokens": "node scripts/sync-tokens.mjs && node sd.config.mjs",
    "tokens:pull": "node scripts/sync-tokens.mjs",
    "verify:full": "pnpm run api:check && pnpm run ci:lighthouse"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.63",
    "@internationalized/date": "^3.10.0",
    "@nuxt/icon": "^1.15.0",
    "@nuxt/image": "^2.0.0",
    "@nuxt/kit": "^4.4.6",
    "@nuxt/scripts": "^0.13.4",
    "@nuxtjs/i18n": "^10.2.4",
    "@nuxtjs/sitemap": "^8.0.12",
    "@pinia/nuxt": "^0.11.3",
    "@tiptap/extension-color": "^3.26.0",
    "@tiptap/extension-highlight": "^3.26.0",
    "@tiptap/extension-link": "^3.26.0",
    "@tiptap/extension-placeholder": "^3.26.0",
    "@tiptap/extension-subscript": "^3.26.0",
    "@tiptap/extension-superscript": "^3.26.0",
    "@tiptap/extension-table": "^3.26.0",
    "@tiptap/extension-table-cell": "^3.26.0",
    "@tiptap/extension-table-header": "^3.26.0",
    "@tiptap/extension-table-row": "^3.26.0",
    "@tiptap/extension-text-align": "^3.13.0",
    "@tiptap/extension-text-style": "^3.26.0",
    "@tiptap/extension-underline": "^3.26.0",
    "@tiptap/pm": "^3.10.7",
    "@tiptap/starter-kit": "^3.10.7",
    "@tiptap/vue-3": "^3.10.7",
    "@vueuse/core": "^14.2.1",
    "@vueuse/integrations": "^14.2.1",
    "async-validator": "^4.2.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cropperjs": "1.6.2",
    "dompurify": "^3.4.7",
    "sanitize-html": "^2.18.1",
    "embla-carousel-vue": "^8.6.0",
    "lucide-vue-next": "^0.539.0",
    "nuxt": "^4.4.2",
    "reka-ui": "^2.9.6",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.3.7",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4",
    "vue-sonner": "^2.0.9",
    "vue-yandex-maps": "^2.1.2"
  },
  "devDependencies": {
    "@types/sanitize-html": "^2.16.2",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@hey-api/openapi-ts": "0.96.0",
    "@nuxt/eslint": "1.17.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tokens-studio/sd-transforms": "2.0.3",
    "@types/node": "^25.6.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "dotenv": "^17.4.2",
    "eslint": "10.8.0",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "shadcn-nuxt": "^2.6.2",
    "style-dictionary": "5.5.0",
    "tailwindcss": "^4.1.14",
    "pixelmatch": "7.2.0",
    "playwright": "1.61.1",
    "pngjs": "7.0.0",
    "sharp": "0.35.3",
    "tsx": "4.22.5",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.9",
    "yaml": "2.9.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "tmp": "^0.2.4"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,vue}": "eslint"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
